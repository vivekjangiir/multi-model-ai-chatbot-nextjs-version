# NVIDIA NIM API Key — get yours free at https://build.nvidia.com/settings/api-keys
# If set here, the chatbot will use it server-side (no need to enter in the UI)
# If left blank, users must enter their key in the chat UI
NVIDIA_API_KEY=nvapi-...

# Base URL (default is fine — only change if you're self-hosting NIM)
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
